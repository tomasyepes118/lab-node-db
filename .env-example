# Copia este archivo y renómbralo a .env
# MONGODB_URI es la URL de tu clúster en MongoDB Atlas.
# Empieza por mongodb+srv://. En este laboratorio no uses mongodb://127.0.0.1

PORT=3000

# Escribe la URI en una sola línea. El nombre lab_personas va antes del signo ?.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/lab_personas?retryWrites=true&w=majority
